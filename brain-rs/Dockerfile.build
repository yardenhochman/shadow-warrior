# Build environment for Shadow Warrior Brain-RS
# Target: aarch64-unknown-linux-gnu (Raspberry Pi 3, Orange Pi Zero 3W)
FROM rust:1.93-bookworm

# Add foreign architecture
RUN dpkg --add-architecture arm64

# Install native dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    # aarch64 dependencies (native since we run on arm64 host)
    libasound2-dev:arm64 \
    libdbus-1-dev:arm64 \
    libssl-dev:arm64 \
    && rm -rf /var/lib/apt/lists/*

# Pre-install rust targets
RUN rustup target add aarch64-unknown-linux-gnu

# Environment variables for cross-compilation
ENV PKG_CONFIG_ALLOW_CROSS=1

WORKDIR /project
