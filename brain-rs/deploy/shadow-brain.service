# Shadow Warrior brain. Installed by deploy/deploy.py (@USER@ and @UID@ are substituted).
[Unit]
Description=Shadow Warrior brain
# Deliberately no network-online.target: the brain must start with no network
# (WLED/Tasmota are retried), but it does want BlueZ for the bag and speakers.
Wants=bluetooth.service user@@UID@.service
# user@UID is the lingering user session that runs PipeWire (Bluetooth audio, ALSA default).
After=bluetooth.service sound.target user@@UID@.service

[Service]
Type=simple
User=@USER@
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
WorkingDirectory=/opt/shadow-brain
ExecStart=/opt/shadow-brain/shadow-warrior-brain
Restart=on-failure
RestartSec=5
# SIGTERM makes the brain disconnect the bag (bounded 3 s) before exiting.
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
