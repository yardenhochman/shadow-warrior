# Sensor station firmware. `just` lists recipes.
# Firmware recipes need the Xtensa toolchain env from `espup install` (~/export-esp.sh).

port := env_var_or_default("STATION_PORT", "")
# Console baud after boot (bootloader is always 115200). Baked in at build time.
baud := env_var_or_default("STATION_BAUD", "115200")
export STATION_BAUD := baud
port_arg := if port == "" { "" } else { "--port " + port }
# Raw audio needs the fast console; `just record` assumes 921600 unless STATION_BAUD says otherwise.
record_baud := env_var_or_default("STATION_BAUD", "921600")
esp_env := "source ~/export-esp.sh >/dev/null 2>&1;"

default:
    @just --list

# Host unit tests: LD2410 parser, level math, GCC-PHAT, framing; plus the python decoder cross-check
test:
    cargo test
    cargo run -q -p station-proto --example sample_stream > target/sample_stream.bin
    uv run tools/station_monitor.py --file target/sample_stream.bin --quiet-text --json --check > target/sample_stream.json
    diff -u tools/testdata/sample_stream.json target/sample_stream.json

# Clippy for host crates and firmware
lint:
    cargo clippy --all-targets -- -D warnings
    cd firmware && {{esp_env}} cargo clippy --release -- -D warnings

# Build the ESP32 firmware (release)
build:
    cd firmware && {{esp_env}} cargo build --release

# Flash the firmware (does not open a monitor)
flash: build
    cd firmware && {{esp_env}} espflash flash {{port_arg}} target/xtensa-esp32-espidf/release/station-fw

# Plain text monitor (frames show up as binary noise; prefer `just decode`)
monitor:
    espflash monitor {{port_arg}} --baud {{baud}}

# Flash then monitor
run: flash monitor

# Decode frames + log text from the station (pass extra args, e.g. `just decode --json`)
decode *args:
    uv run tools/station_monitor.py {{port_arg}} --baud {{baud}} {{args}}

# Live direction view / recording / histogram (see `uv run tools/doa_view.py --help`)
doa *args:
    uv run tools/doa_view.py {{port_arg}} --baud {{baud}} {{args}}

# Flash the 921600-baud build that raw audio recording needs
flash-fast:
    STATION_BAUD=921600 just flash

# Record raw 16 kHz stereo audio to ../brain-rs/clips/station/<label>_<n>.wav (needs `just flash-fast`)
record label="clip" *args:
    uv run tools/station_record.py {{port_arg}} --baud {{record_baud}} {{label}} {{args}}

# Reset the board and print the power-on self test (mics + radar); exit code 0 PASS, 1 WARN, 2 FAIL
selftest *args:
    uv run tools/selftest.py {{port_arg}} --baud {{baud}} {{args}}

# Install the Xtensa toolchain and flashing tools if missing
setup:
    command -v espup >/dev/null || cargo install espup --locked
    command -v ldproxy >/dev/null || cargo install ldproxy --locked
    # espflash >= 4.7 needs rustc >= 1.95; 4.5.0 builds on older stable
    command -v espflash >/dev/null || cargo install espflash@4.5.0 --locked
    test -f ~/export-esp.sh || espup install
