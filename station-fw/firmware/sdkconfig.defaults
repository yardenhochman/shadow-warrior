# Rust needs more main-task stack than C (default 3K).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# Binary protocol frames share UART0 with the log. The console must not turn
# 0x0A into 0x0D 0x0A, or frames containing 0x0A fail their CRC.
# (IDF <= 5.x newlib name and the newer libc name; unknown keys are ignored.)
CONFIG_NEWLIB_STDOUT_LINE_ENDING_LF=y
CONFIG_LIBC_STDOUT_LINE_ENDING_LF=y

# Console stays at 115200 so the ROM/bootloader output is readable; the app
# may switch to STATION_BAUD at runtime (see README).
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# 240 MHz, 4 MB flash on WROOM-32 modules.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# BLE provisioning: NimBLE, peripheral only (small RAM footprint; coexists with Wi-Fi).
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y

# Wi-Fi memory: this station moves little traffic; keep RAM for BLE, DSP buffers and thread stacks.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=12
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
CONFIG_BTDM_CTRL_BLE_MAX_CONN=1
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=10
